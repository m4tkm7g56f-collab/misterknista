{
  "description": "Schranke: begrenzt Lese- und Schreibpfade, Abruf-URLs und Browser-Werkzeuge der Plugin-Subagents und prüft geladene Seiten-URLs. Andere Aufrufe bleiben unberührt.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Write|Edit|MultiEdit|NotebookEdit|WebFetch|mcp__plugin_ai-vendor-assessment_browser__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/schranke.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_ai-vendor-assessment_browser__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/schranke.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
